    rownames(X2) <- ids
    present1 <- ids[!is.na(X1[, 1])]
    present2 <- ids[!is.na(X2[, 1])]
    exps <- ExperimentList(list(
        Mod1 = t(X1[present1, , drop = FALSE]),
        Mod2 = t(X2[present2, , drop = FALSE])
