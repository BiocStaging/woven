    cd <- DataFrame(row.names = ids, group = Y)
    mae <- MultiAssayExperiment(exps, colData = cd)
    fit_mae <- woven(mae, Y = "group", K = K)
    dim(Z(fit_mae)) # same 60 x 2 -- all subjects scored
}

